# ==============================================================================
# WHOLESALE MEDICINE DISTRIBUTION MANAGEMENT SYSTEM (WMDMS)
# Environment Variables Specification
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to Browser via NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Anon / Publishable Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Application Base URL (for email links, redirection, and CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Metadata
NEXT_PUBLIC_APP_NAME="PharmaDist Wholesale ERP"
NEXT_PUBLIC_APP_VERSION="1.0.0"


# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NEVER Expose to Browser / Client Components)
# ------------------------------------------------------------------------------
# Supabase Service Role Key (High privilege, for server-side administrative tasks only)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Prisma Database Connection (Transaction Pooler - Port 6543 for PgBouncer / Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Prisma Direct Database Connection (Direct Session - Port 5432 for Migrations & Introspection)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Resend API Key for Transactional Invoices, Password Resets & Alerts
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# Notification Sender Email Address
EMAIL_FROM="PharmaDist ERP <no-reply@yourdomain.com>"
